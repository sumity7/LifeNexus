# Copy to client/.env and adjust. Never commit the real .env file.

# Only needed when the frontend and API are deployed as SEPARATE origins
# (e.g. frontend on Vercel, API on Render). Leave unset for local dev —
# Vite's dev-server proxy (see vite.config.js) forwards /api to localhost:5000
# same-origin, which is what lets the httpOnly refresh cookie work locally.
#
# Set to the API's bare origin — NO trailing slash, NO /api suffix (the app
# appends /api itself, so including it here would produce /api/api/...).
#
# VITE_API_URL=https://lifenexus.onrender.com
VITE_API_URL=
