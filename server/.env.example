# Copy to server/.env and adjust. Never commit the real .env file.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/lifeos

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=7

# Comma-separated list of allowed browser origins (only needed when the client runs on another origin)
CLIENT_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the app (e.g. 1 behind Nginx/Heroku) — used for rate limiting by IP
TRUST_PROXY=0

# ── Documents ─────────────────────────────────────────────────────────────
# "local" writes to disk — fine for a VPS with a persistent volume, but files
# are LOST on redeploy/restart on platforms with ephemeral disks (e.g. Render/
# Railway/Heroku free-hobby tiers). Use "s3" there instead.
STORAGE_PROVIDER=local
STORAGE_DIR=./uploads

# "s3" — AWS S3 or any S3-compatible provider (Cloudflare R2, MinIO, DigitalOcean
# Spaces, Backblaze B2). Only read when STORAGE_PROVIDER=s3.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for non-AWS providers — their S3-compatible endpoint, e.g. R2:
# https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Most non-AWS providers need path-style URLs — set true for R2/MinIO/Spaces/B2.
S3_FORCE_PATH_STYLE=false

# OCR / text extraction provider. Leave empty: LifeOS never fabricates extracted text.
EXTRACTION_PROVIDER=

# ── Email (optional) ────────────────────────────────────────────────────────
# The app works fully without this; only "forgot password" email delivery needs
# it (the request still succeeds either way — see docs/LIFEOS_SECURITY.md).
# "smtp" works with any SMTP-speaking provider: a Gmail app password, Brevo,
# Resend, Postmark, Mailgun, SES SMTP, or a self-hosted mail server.
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587/25 (STARTTLS, upgraded automatically).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── AI (optional) ─────────────────────────────────────────────────────────
# "none" disables AI features cleanly (the app still works fully without it).
# "anthropic" (paid) requires ANTHROPIC_API_KEY, from console.anthropic.com.
# "gemini" (free tier available, no card required) requires GEMINI_API_KEY,
# from aistudio.google.com → "Get API key". Never commit a real key.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# claude-opus-5 for anthropic, gemini-3.6-flash for gemini (leave unset to use each provider's default).
AI_MODEL=
AI_MAX_OUTPUT_TOKENS=16000
AI_TIMEOUT_MS=90000
# Per-user AI requests allowed per minute.
AI_RATE_LIMIT_PER_MIN=20
# "default" enables Anthropic server-side refusal fallbacks; "off" disables them. Ignored by gemini.
AI_REFUSAL_FALLBACK=default
